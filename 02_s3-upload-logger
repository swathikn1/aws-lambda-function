exports.handler=async(event)=>{
    console.log("Event received from S3:");
    console.log(JSON.stringify(event,null,2));

    if(!event.Records){
        console.log("No records found in the event. Trigger might not be S3 or misconfigured.");
        return;
    }

    event.Records.forEach(record=>{
        if (!record.s3) {
            console.log("Record does not have S3 info:", record);
            return;
        }

        const bucketName=record.s3.bucket.name;
        const objectKey=record.s3.object.key;
        const fileSize=record.s3.object.size;
        const eventTime=record.eventTime;

        console.log("File uploaded:");
        console.log("Bucket Name:", bucketName);
        console.log("File Name:", objectKey);
        console.log("File Size (bytes):", fileSize);
        console.log("Time of Upload:", eventTime);
    });

    return {
        statusCode: 200,
        body: JSON.stringify("File details logged to CloudWatch!")
    };
};
